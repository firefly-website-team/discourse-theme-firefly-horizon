{
  "name": "Firefly-Horizon",
  "authors": "t-firefly Team",
  "theme_version": "1.0.0",
  "modifiers": {
    "svg_icons": [
      "fire",
      "far-square-check",
      "far-square",
      "thumbtack",
      "reply",
      "heart",
      "user-plus"
    ],
    "serialize_topic_is_hot": true,
    "serialize_topic_excerpts": {
      "type": "setting",
      "value": "topic_card_high_context"
    },
    "only_theme_color_schemes": false
  },
  "color_schemes": {
    "Firefly": {
      "primary": "1F2933",
      "secondary": "ffffff",
      "tertiary": "FF6600",
      "tertiary-med-or-tertiary": "FF6600",
      "selected": "FFE1CC",
      "header_background": "ffffff",
      "header_primary": "1F2933",
      "hover": "FFF1E8"
    },
    "Firefly Dark": {
      "primary": "CCCCCC",
      "secondary": "1A1A1A",
      "tertiary": "FF6600",
      "tertiary-med-or-tertiary": "FF6600",
      "selected": "2C2C2C",
      "header_background": "1A1A1A",
      "header_primary": "AAAAAA",
      "hover": "2C2C2C"
    }
  },
  "screenshots": [
    "screenshots/light.png",
    "screenshots/dark.png"
  ],
  "theme_site_settings": {
    "enable_welcome_banner": true,
    "search_experience": "search_field"
  }
}
